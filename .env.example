# Berth configuration. Copy to .env and edit; every variable is optional and the
# value shown is the default. `docker compose` reads this file for both its own
# substitutions and the backend container's environment. Only .env reaches the
# container: a variable exported in your shell (BERTH_LOG_LEVEL=debug docker
# compose up) is ignored, except BERTH_HTTP_PORT and TRAEFIK_LOG_LEVEL, which
# compose substitutes itself.
#
# Running the backend directly (go run ./cmd/berth) does not read .env; export
# the variables first:   set -a; . ./.env; set +a

# --- Backend ------------------------------------------------------------------
# Address the HTTP API listens on. (docker compose pins this to :8080.)
BERTH_LISTEN_ADDR=:8080
# SQLite database file; its directory is created with mode 0700.
# (docker compose pins this to /data/berth.db, a named volume.)
BERTH_DB_PATH=./data/berth.db
# debug | info | warn | error. At debug, every ForwardAuth check is logged.
BERTH_LOG_LEVEL=info

# --- Sessions and passwords ---------------------------------------------------
# How long a login lasts (Go duration: 30m, 168h, ...). Fixed, not sliding.
BERTH_SESSION_TTL=168h
# Mark the session cookie Secure. Set to true as soon as Berth is served over
# HTTPS; browsers will not send a Secure cookie over plain HTTP.
BERTH_COOKIE_SECURE=false
# bcrypt work factor, 10-15. Each +1 doubles the cost of a login.
BERTH_BCRYPT_COST=12

# --- Workspace defaults (stamped onto a user's workspace at registration) ------
# CPUs must not exceed the number of CPUs of the Docker host: the daemon refuses
# a container asking for more, so every start would fail. The value is copied
# into each workspace at registration; changing it later does not touch users
# who already registered.
BERTH_DEFAULT_MEM_MB=2048
BERTH_DEFAULT_CPUS=2.0

# --- Workspace containers -----------------------------------------------------
# The image every workspace runs. `docker compose up --build` builds it as
# berth/workspace:latest from images/workspace. It is never pulled.
BERTH_WORKSPACE_IMAGE=berth/workspace:latest
# Traefik's container name, attached to each user's private network. "none"
# skips attaching (running the backend without Traefik). docker compose pins it.
BERTH_TRAEFIK_CONTAINER=berth-traefik
# The Traefik entrypoint the workspace routers listen on.
BERTH_TRAEFIK_ENTRYPOINT=web
# UDP ports for each workspace's WebRTC video (neko), published 1:1 on the host.
# Keep the range below Linux's ephemeral ports (32768+), open it in the firewall,
# and size it as users x BERTH_UDP_PORTS_PER_WORKSPACE.
BERTH_UDP_PORT_MIN=30000
BERTH_UDP_PORT_MAX=30999
BERTH_UDP_PORTS_PER_WORKSPACE=8
# Remote browser screen, WIDTHxHEIGHT@FPS.
BERTH_RESOLUTION=1280x720@30
# The address browsers reach this host on, advertised for WebRTC. Required when
# the host is behind NAT or in a cloud VM; leave empty on a LAN.
BERTH_PUBLIC_IP=
# /dev/shm size for Chromium, and the process cap that contains fork bombs.
BERTH_SHM_MB=2048
BERTH_PIDS_LIMIT=2048
# Graceful stop before SIGKILL, and the most a single "power on" may take.
BERTH_STOP_TIMEOUT=15s
BERTH_START_TIMEOUT=45s

# --- docker compose only ------------------------------------------------------
# The group id that owns /var/run/docker.sock, so the unprivileged backend can use
# it. REQUIRED:    DOCKER_GID=$(stat -c %g /var/run/docker.sock)
DOCKER_GID=
# Host port Traefik publishes.
BERTH_HTTP_PORT=80
# INFO | DEBUG | WARN | ERROR
TRAEFIK_LOG_LEVEL=INFO
