# Berth configuration. Copy to .env and edit; every variable is optional and the
# value shown is the default. `docker compose` reads this file for both its own
# substitutions and the backend container's environment. Only .env reaches the
# container: a variable exported in your shell (BERTH_LOG_LEVEL=debug docker
# compose up) is ignored, except BERTH_HTTP_PORT and TRAEFIK_LOG_LEVEL, which
# compose substitutes itself.
#
# Running the backend directly (go run ./cmd/berth) does not read .env; export
# the variables first:   set -a; . ./.env; set +a

# --- Backend ------------------------------------------------------------------
# Address the HTTP API listens on. (docker compose pins this to :8080.)
BERTH_LISTEN_ADDR=:8080
# SQLite database file; its directory is created with mode 0700.
# (docker compose pins this to /data/berth.db, a named volume.)
BERTH_DB_PATH=./data/berth.db
# debug | info | warn | error. At debug, every ForwardAuth check is logged.
BERTH_LOG_LEVEL=info

# --- Sessions and passwords ---------------------------------------------------
# How long a login lasts (Go duration: 30m, 168h, ...). Fixed, not sliding.
BERTH_SESSION_TTL=168h
# Mark the session cookie Secure. Set to true as soon as Berth is served over
# HTTPS; browsers will not send a Secure cookie over plain HTTP.
BERTH_COOKIE_SECURE=false
# bcrypt work factor, 10-15. Each +1 doubles the cost of a login.
BERTH_BCRYPT_COST=12

# --- Workspace defaults (stamped onto a user's workspace at registration) ------
BERTH_DEFAULT_MEM_MB=2048
BERTH_DEFAULT_CPUS=2.0

# --- docker compose only ------------------------------------------------------
# Host port Traefik publishes.
BERTH_HTTP_PORT=80
# INFO | DEBUG | WARN | ERROR
TRAEFIK_LOG_LEVEL=INFO
