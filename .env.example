# Berth configuration. Copy to .env and edit; every variable is optional and the
# value shown is the default. `docker compose` reads this file for both its own
# substitutions and the backend container's environment. Only .env reaches the
# container: a variable exported in your shell (BERTH_LOG_LEVEL=debug docker
# compose up) is ignored, except BERTH_HTTP_PORT and TRAEFIK_LOG_LEVEL, which
# compose substitutes itself.
#
# Running the backend directly (go run ./cmd/berth) does not read .env; export
# the variables first:   set -a; . ./.env; set +a

# --- Backend ------------------------------------------------------------------
# Address the HTTP API listens on. (docker compose pins this to :8080.)
BERTH_LISTEN_ADDR=:8080
# SQLite database file; its directory is created with mode 0700.
# (docker compose pins this to /data/berth.db, a named volume.)
BERTH_DB_PATH=./data/berth.db
# debug | info | warn | error. At debug, every ForwardAuth check is logged.
BERTH_LOG_LEVEL=info

# --- Sessions and passwords ---------------------------------------------------
# How long a login lasts (Go duration: 30m, 168h, ...). Fixed, not sliding.
BERTH_SESSION_TTL=168h
# Mark the session cookie Secure. Set to true as soon as Berth is served over
# HTTPS; browsers will not send a Secure cookie over plain HTTP.
BERTH_COOKIE_SECURE=false
# bcrypt work factor, 10-15. Each +1 doubles the cost of a login.
BERTH_BCRYPT_COST=12

# --- Workspace defaults (stamped onto a user's workspace at registration) ------
# CPUs must not exceed the number of CPUs of the Docker host: the daemon refuses
# a container asking for more, so every start would fail. The value is copied
# into each workspace at registration; changing it later does not touch users
# who already registered.
BERTH_DEFAULT_MEM_MB=2048
BERTH_DEFAULT_CPUS=2.0

# --- Workspace containers -----------------------------------------------------
# The image every workspace runs. `docker compose up --build` builds it as
# berth/workspace:latest from images/workspace. It is never pulled.
BERTH_WORKSPACE_IMAGE=berth/workspace:latest
# Traefik's container name, attached to each user's private network. "none"
# skips attaching (running the backend without Traefik). docker compose pins it.
BERTH_TRAEFIK_CONTAINER=berth-traefik
# The Traefik entrypoint the workspace routers listen on.
BERTH_TRAEFIK_ENTRYPOINT=web
# UDP ports for each workspace's WebRTC video (neko), published 1:1 on the host.
# Keep the range below Linux's ephemeral ports (32768+), open it in the firewall,
# and size it as users x BERTH_UDP_PORTS_PER_WORKSPACE.
# One port per workspace (the default) is shared by every viewer of that workspace
# (neko's UDP multiplexer). A larger block gives each viewer a port of its own;
# measured: a closed tab keeps its port for 5-10 s and ports were seen to stay
# bound until neko restarted. A user's block is fixed when it is first allocated,
# so changing this later only affects workspaces that have none yet.
BERTH_UDP_PORT_MIN=30000
BERTH_UDP_PORT_MAX=30999
BERTH_UDP_PORTS_PER_WORKSPACE=1
# Remote browser screen, WIDTHxHEIGHT@FPS.
BERTH_RESOLUTION=1280x720@30
# The address browsers reach this host on, advertised as the WebRTC (video)
# candidate. REQUIRED for every browser that is not on the Docker host itself, a
# LAN included: without it neko offers only the workspace's private bridge address
# (172.x.y.z) and the video never connects. LAN: the host's LAN address; internet:
# its public address. Empty is only right when you browse from the Docker host
# (and neko then tries to learn the public IP from checkip.amazonaws.com at every
# workspace start).
BERTH_PUBLIC_IP=
# /dev/shm size for Chromium, and the process cap that contains fork bombs.
BERTH_SHM_MB=2048
BERTH_PIDS_LIMIT=2048
# Graceful stop before SIGKILL, and the most a single "power on" may take.
BERTH_STOP_TIMEOUT=15s
BERTH_START_TIMEOUT=45s

# How often the backend re-attaches Traefik to the network of every workspace that
# is starting or running. Docker drops those attachments when the Traefik container
# is recreated (a redeploy), and until the next attach those workspaces are
# unreachable: this is the longest wait. Each pass costs a few Docker API calls per
# such workspace, so keep it above a few seconds.
BERTH_PROXY_ATTACH_INTERVAL=10s

# --- the reaper (idle stop, removal after a week, reconcile) --------------------
# A running workspace nobody has used for this long is stopped (docker stop: its
# programs end, its files and its container stay). "Used" means: the web page is
# open (it sends a heartbeat every 30 s, hidden tab or not), or the workspace's
# average CPU load since the reaper's previous look was at or above
# BERTH_IDLE_CPU_PERCENT (so a build or a long job is not killed). A closed tab, a
# sleeping laptop or a lost connection are not use. After a backend restart nobody
# is stopped until a full timeout has passed. Below 5m the backend warns: a
# background tab's timers can be held to once a minute or less.
BERTH_IDLE_TIMEOUT=30m
# A workspace that has been stopped this long loses its container (docker rm); its
# data volume is never deleted. The next power-on creates a new container on the
# same volume, a few seconds slower than starting the kept one. The age is counted
# from the moment it was stopped.
BERTH_RECLAIM_AFTER=168h
# How often the reaper looks at every workspace. A stop or a removal happens at
# the first look after its deadline, so the real idle time is the timeout plus up
# to one interval. Each look reads one cheap CPU figure per running workspace.
BERTH_REAPER_INTERVAL=1m
# Average CPU, in percent of ONE core (100 = a full core), between two looks at or
# above which a workspace counts as in use. An idle workspace measures well under
# 1% on average (its own healthcheck alone adds about that much); 0 ignores CPU.
BERTH_IDLE_CPU_PERCENT=5

# --- docker compose only ------------------------------------------------------
# The group id that owns /var/run/docker.sock, so the unprivileged backend can use
# it. REQUIRED:    DOCKER_GID=$(stat -c %g /var/run/docker.sock)
DOCKER_GID=
# Host port Traefik publishes.
BERTH_HTTP_PORT=80
# INFO | DEBUG | WARN | ERROR
TRAEFIK_LOG_LEVEL=INFO

# --- Development and tests only (the backend never reads these) -----------------
# Read from the shell by `npm run dev` (web/vite.config.ts), not from this file: the
# stack that the Vite dev server forwards /api and /ws to. The value shown is the
# default, so it is commented out here.
# BERTH_DEV_TARGET=http://127.0.0.1:18090
#
# The browser tests (web/e2e) have their own variables (BASE_URL, E2E_USER,
# E2E_PASSWORD, E2E_DOCKER, CHROMIUM, ...): web/README.md lists them. The Go
# integration tests (go test -tags integration) read BERTH_TEST_IMAGE (a local image
# that keeps running, for internal/docker) and BERTH_TEST_TRAEFIK (path of a traefik
# v3 binary, for internal/workspace; the test is skipped without it).
